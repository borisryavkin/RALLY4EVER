rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function active() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mergedInto == null;
    }
    // A protected profile role overrides a claim, allowing immediate demotion.
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        .get('role', request.auth.token.get('role', 'participant'));
    }
    function admin() { return active() && role() == 'admin' && request.auth.token.get('role', '') == 'admin'; }
    function own(uid) { return active() && request.auth.uid == uid; }
    function coachClaim() {
      return request.auth.token.get('role', '') == 'coach'
        || request.auth.token.get('roles', []).hasAny(['coach']);
    }
    function coachAccess() {
      return active() && role() == 'coach' && coachClaim()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coachEnabled', true) != false;
    }
    function assignedCoach(eventId) {
      return coachAccess()
        && request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.coachUids;
    }
    function eventExists(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId));
    }
    function published(eventId) {
      return eventExists(eventId)
        && get(/databases/$(database)/documents/events/$(eventId)).data.status == 'published';
    }
    function text(value, max) { return value is string && value.size() <= max; }
    // A list of allowed option keys, no duplicates, at most `max` entries.
    function optionList(value, allowed, max) {
      return value is list && value.size() <= max && value.hasOnly(allowed)
        && value.toSet().size() == value.size();
    }
    // If the list contains any of `exclusive`, it must contain only that one entry.
    function exclusiveOk(value, exclusive) {
      return !value.hasAny(exclusive) || (value.size() == 1 && value.hasAny(exclusive));
    }
    function validAbout(d) {
      return d is map
        && d.keys().hasOnly(['ageRange', 'gender', 'accessNeed', 'occupation', 'heardAbout',
          'heardAboutOther', 'loneliness', 'satisfaction', 'culturalBackground'])
        && text(d.get('ageRange', ''), 80) && text(d.get('gender', ''), 80)
        && text(d.get('accessNeed', ''), 500)
        && optionList(d.get('occupation', []),
          ['working', 'studying', 'looking_for_work', 'retired', 'prefer_not_to_say'], 5)
        && exclusiveOk(d.get('occupation', []), ['prefer_not_to_say'])
        && optionList(d.get('heardAbout', []),
          ['friend', 'uni_campus', 'social_media', 'local_club', 'other'], 5)
        && text(d.get('heardAboutOther', ''), 200)
        // Required while "other" is selected, cleared otherwise.
        && (d.get('heardAbout', []).hasAny(['other'])
          ? d.get('heardAboutOther', '').size() > 0
          : d.get('heardAboutOther', '').size() == 0)
        && text(d.get('loneliness', ''), 80) && text(d.get('satisfaction', ''), 80)
        && optionList(d.get('culturalBackground', []),
          ['aboriginal_torres_strait_islander', 'born_outside_australia', 'neither', 'prefer_not_to_say'], 4)
        && exclusiveOk(d.get('culturalBackground', []), ['neither', 'prefer_not_to_say']);
    }
    function validProfile(d) {
      return d.keys().hasAll(['uid', 'email', 'emailLower', 'role', 'mergedInto', 'createdAt', 'updatedAt',
          'firstName', 'lastName', 'postcode', 'injuries', 'preferences', 'about'])
        && d.keys().hasOnly(['uid', 'email', 'emailLower', 'role', 'coachEnabled', 'mergedInto', 'createdAt', 'updatedAt',
          'firstName', 'lastName', 'postcode', 'injuries', 'preferences', 'about', 'photoUpdatedAt'])
        && text(d.firstName, 100) && text(d.lastName, 100) && text(d.postcode, 20)
        && text(d.injuries, 2000)
        && d.preferences is map
        && d.preferences.keys().hasAll(['useInReports', 'wellbeingCheckIns', 'showInWhosGoing', 'marketingEmails'])
        && d.preferences.keys().hasOnly(['useInReports', 'wellbeingCheckIns', 'showInWhosGoing', 'marketingEmails'])
        && d.preferences.useInReports is bool && d.preferences.wellbeingCheckIns is bool
        && d.preferences.showInWhosGoing is bool && d.preferences.marketingEmails is bool
        && validAbout(d.about);
    }
    // Phone/emergency-contact are deliberately NOT on the main profile: only
    // the owner, admin, and a coach actually running an event this person is
    // involved in may read them -- never other participants, never surfaced
    // through "Who's counted in". visibleToCoachUids is maintained server-side
    // (see functions/src/service.ts) from real RSVP/check-in relationships;
    // a participant can never set it themselves.
    function validContact(d) {
      return d.keys().hasAll(['mobile', 'mobileVerified', 'emergencyContact', 'visibleToCoachUids', 'updatedAt'])
        && d.keys().hasOnly(['mobile', 'mobileVerified', 'emergencyContact', 'visibleToCoachUids', 'updatedAt'])
        && text(d.mobile, 40) && d.mobileVerified == false
        && d.emergencyContact is map
        && d.emergencyContact.keys().hasAll(['name', 'mobile'])
        && d.emergencyContact.keys().hasOnly(['name', 'mobile'])
        && text(d.emergencyContact.name, 200) && text(d.emergencyContact.mobile, 40);
    }

    match /users/{uid} {
      allow read: if own(uid) || admin();
      // Creation is server-only: reserve the verified normalized email atomically.
      allow create, delete: if admin();
      allow update: if admin() || (own(uid) && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'postcode', 'injuries', 'preferences', 'about', 'photoUpdatedAt', 'updatedAt'])
        && request.resource.data.updatedAt == request.time);
      match /devices/{deviceId} {
        allow read, delete: if own(uid) || admin();
        allow create, update: if admin() || (own(uid)
          && request.resource.data.keys().hasAll(['token', 'platform', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && text(request.resource.data.token, 4096)
          && request.resource.data.token.size() > 0
          && request.resource.data.platform in ['android', 'ios', 'web']
          && request.resource.data.updatedAt == request.time);
      }
      match /private/contact {
        allow read: if own(uid) || admin()
          || (coachAccess() && request.auth.uid in resource.data.get('visibleToCoachUids', []));
        // Always created server-side by registerIdentity (Admin SDK bypasses
        // rules), so a client never needs to create this document.
        allow create: if admin();
        // visibleToCoachUids is written only by trusted server code; a
        // client update can never set or widen it.
        allow update: if admin() || (own(uid) && validContact(request.resource.data)
          && request.resource.data.visibleToCoachUids == resource.data.get('visibleToCoachUids', [])
          && request.resource.data.updatedAt == request.time);
        allow delete: if admin();
      }
    }
    match /emailIdentities/{normalizedEmail} { allow read, write: if admin(); }
    match /programs/{programId} {
      allow read: if active() && (resource.data.status in ['active', 'archived'] || admin());
      allow write: if false; // Validated, audited admin callables only.
    }
    match /guestClaimAudits/{id} { allow read: if admin(); allow write: if false; }
    match /guests/{id} { allow read: if admin(); allow write: if false; }
    match /guestEmailIdentities/{id} { allow read: if admin(); allow write: if false; }
    match /noAppRequests/{id} { allow read, write: if false; }
    match /venues/{venueId} { allow read: if active(); allow write: if false; }
    match /demoRemovalBackups/{backupId} { allow read: if admin(); allow write: if false; }
    match /catalogueAudits/{auditId} { allow read: if admin(); allow write: if false; }
    // Operational data from the programs spreadsheet import (coach/contact
    // names and numbers, internal notes, attendance figures, raw
    // unparsed spreadsheet text) -- never participant-readable. Written
    // only by the admin-run import script via the Admin SDK, which
    // bypasses rules entirely; these are read-only to admins, matching
    // catalogueAudits above. See docs/import/programs-mapping.md.
    match /programOperational/{programId} { allow read: if admin(); allow write: if false; }
    match /venueOperational/{venueId} { allow read: if admin(); allow write: if false; }
    function legacyEvent(eventId) {
      return !get(/databases/$(database)/documents/events/$(eventId)).data.get('catalogueManaged', false);
    }
    match /events/{eventId} {
      allow read: if active() && (resource.data.status in ['published', 'cancelled'] || assignedCoach(eventId) || admin());
      allow write: if admin();
    }
    match /eventSecrets/{eventId} {
      // No client, even an admin client, can fetch or modify QR credentials.
      allow read, write: if false;
    }
    match /rsvps/{id} {
      allow read: if own(resource.data.uid) || assignedCoach(resource.data.eventId) || admin();
      allow create: if admin() || (own(request.resource.data.uid)
        && id == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'eventId', 'createdAt', 'cancelledAt', 'source'])
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'createdAt', 'cancelledAt', 'source'])
        && legacyEvent(request.resource.data.eventId)
        && published(request.resource.data.eventId)
        && request.time <= get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.endsAt
        && request.resource.data.createdAt == request.time
        && request.resource.data.cancelledAt == null && request.resource.data.source == 'app');
      allow update: if admin() || (own(resource.data.uid)
        && legacyEvent(resource.data.eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelledAt'])
        && (request.resource.data.cancelledAt == request.time
          || (request.resource.data.cancelledAt == null && published(resource.data.eventId)
            && request.time <= get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.endsAt)));
      allow delete: if admin();
    }
    match /checkins/{id} {
      allow read: if own(resource.data.uid) || assignedCoach(resource.data.eventId) || admin();
      // Assigned coach/admin operations use trusted callables too, preserving scans/audit history.
      allow write: if false;
    }
    match /formPublicationAudits/{id} { allow read: if admin(); allow write: if false; }
    function publishedForm(formId) {
      let f = get(/databases/$(database)/documents/forms/$(formId)).data;
      return f.publishedAt is timestamp && f.publishedAt <= request.time
        && f.get('published', true) != false && f.get('status', 'published') != 'draft'
        && f.get('body', f.get('content', '')).size() > 0;
    }
    match /forms/{formId} {
      allow read: if active();
      allow write: if admin();
    }
    match /consents/{id} {
      allow read: if own(resource.data.uid) || admin();
      allow create, update: if admin() || (own(request.resource.data.uid)
        && request.resource.data.keys().hasAll(['uid', 'formId', 'formType', 'version', 'signedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'formId', 'formType', 'version', 'signedAt'])
        && id == request.auth.uid + '_' + request.resource.data.formId
        && request.resource.data.formType in ['conduct', 'waiver', 'photo-release', 'data-collection']
        && publishedForm(request.resource.data.formId)
        && request.resource.data.formType == get(/databases/$(database)/documents/forms/$(request.resource.data.formId)).data.formType
        && request.resource.data.version == get(/databases/$(database)/documents/forms/$(request.resource.data.formId)).data.version
        && request.resource.data.signedAt == request.time
        && (!exists(/databases/$(database)/documents/consents/$(id))
          || resource.data.version != request.resource.data.version));
      allow delete: if admin();
    }
    function eligibleForFeedback(d) {
      let scan = get(/databases/$(database)/documents/checkins/$(d.eventId + '_' + request.auth.uid)).data;
      return scan.status == 'confirmed' && scan.uid == request.auth.uid
        && request.time >= get(/databases/$(database)/documents/events/$(d.eventId)).data.endsAt;
    }
    match /feedback/{id} {
      allow read: if own(resource.data.uid) || assignedCoach(resource.data.eventId) || admin();
      allow create: if admin() || (own(request.resource.data.uid)
        && id == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'eventId', 'rating', 'tags', 'comment', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'rating', 'tags', 'comment', 'createdAt'])
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 6
        && request.resource.data.tags.hasOnly(['coaching', 'people', 'atmosphere', 'accessibility', 'timing', 'other'])
        && text(request.resource.data.comment, 2000)
        && request.resource.data.createdAt == request.time && eligibleForFeedback(request.resource.data));
      allow update, delete: if admin();
    }
    match /notifications/{id} {
      allow read: if admin() || (own(resource.data.uid) && (!resource.data.type.matches('checkin-.*') || coachAccess()));
      allow update: if admin() || (own(resource.data.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time);
      allow create, delete: if admin();
    }
    match /roleAudits/{id} { allow read: if admin(); allow write: if false; }
    match /profilePhotoAudits/{id} { allow read: if admin(); allow write: if false; }
    match /roleChanges/{id} { allow read, write: if false; }
    match /mergeAudits/{id} { allow read, write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
