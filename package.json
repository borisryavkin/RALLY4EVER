{
  "name": "rally4ever-emulators",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-rally4ever --only auth,firestore",
    "test:emulator": "firebase emulators:exec --project demo-rally4ever --only auth,firestore 'node --test --test-concurrency=1 tests/rules/*.test.mjs'",
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
