rules_version = '2';

// profilePhotos/{uid}/avatar.jpg is the only path in use. Removal by a
// coach/admin (functions/src/admin_roles.ts's removeParticipantPhoto) goes
// through the Admin SDK, which bypasses these rules entirely -- that path
// doesn't need a rule here, only the direct owner upload/delete does.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Mirrors firestore.rules' role()/admin(): the Firestore profile's role
    // field, not the Auth claim -- see that file's comment on why.
    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }
    function admin() { return signedIn() && role() == 'admin'; }
    // Same relationship firestore.rules' private/contact already grants
    // phone/emergency-contact read on: a coach actually running an event
    // this person is involved in, maintained server-side in
    // visibleToCoachUids -- never a blanket "any coach" or public read.
    function assignedCoach(uid) {
      return signedIn() && role() == 'coach'
        && request.auth.uid in firestore.get(/databases/(default)/documents/users/$(uid)/private/contact).data.visibleToCoachUids;
    }
    match /profilePhotos/{uid}/avatar.jpg {
      allow read: if owner(uid) || admin() || assignedCoach(uid);
      allow write: if owner(uid)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if owner(uid);
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
